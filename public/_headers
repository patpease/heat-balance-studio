# Caching only.
#
# The SECURITY headers are set by the Worker script, not here — under Workers
# the script owns every response, and `run_worker_first` is what puts those
# headers on assets rather than only on the 404. Duplicating them in this file
# would leave two places to change and one of them silently ignored.

# Content-hashed by Vite, so these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed. Must revalidate, or a deploy leaves people on the old bundle.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
